# ── Agora configuration ──────────────────────────────────────────────
# Copy this file to `.env` (or run `npm run setup`, which does it for you).

# SQLite database file (relative to the project root).
DATABASE_URL="file:./data/agora.db"

# Where uploaded documents are stored.
UPLOAD_DIR="./data/uploads"

# Max upload size in megabytes.
MAX_UPLOAD_MB="20"

# Public address of Agora, used in emails and invitation links
# (detected automatically from the request when empty).
APP_URL=""

# Set to "true" when serving Agora over HTTPS so cookies are marked Secure.
SECURE_COOKIES="false"

# Who can create an account:
#   open   → anyone (default)
#   invite → only people with a join code (the very first account is always allowed)
#   closed → nobody; administrators add members and send invitation links
SIGNUP_MODE="open"

# Can any signed-in person create a new association? ("false" = only the first one)
ALLOW_NEW_ASSOCIATIONS="true"

# How many days the activity history is kept (read notifications: 90 days).
RETENTION_DAYS="365"

# Optional email (notifications, password reset).
#   SMTP_URL="smtps://user:password@smtp.example.org:465"
#   SMTP_URL="log"   → emails are printed in the console (development)
SMTP_URL=""
MAIL_FROM="Agora <no-reply@example.org>"
